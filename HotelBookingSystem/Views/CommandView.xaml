<UserControl x:Class="HotelBookingSystem.Views.CommandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ICard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="20"/>
            <Setter Property="BorderBrush"     Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OpBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground"               Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: Operations (Command Sources) -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- Header -->
                <TextBlock Text="Operations Desk" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,5"/>
                <TextBlock Text="Execute actions safely. Every operation is recorded and can be fully undone." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,25"/>

                <!-- Booking Management -->
                <Border Style="{StaticResource ICard}" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="📅" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="BOOKING MANAGEMENT" FontSize="11" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Text="Select Booking:" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding CommandCtrl.BookingIds}" SelectedItem="{Binding CommandCtrl.SelectedBookingId}" Padding="10,8" Margin="0,0,0,10" Background="#F1F5F9" BorderThickness="0"/>
                        
                        <Border Background="#F0F9FF" CornerRadius="4" Margin="0,0,0,15" Padding="12">
                            <TextBlock Text="{Binding CommandCtrl.SelectedBookingInfo}" FontSize="11" Foreground="#0369A1" TextWrapping="Wrap"/>
                        </Border>

                        <UniformGrid Columns="2" Rows="1">
                            <Button Content="✓ Confirm" Command="{Binding CommandCtrl.ConfirmBookingCommand}" Background="#15803D" Style="{StaticResource OpBtn}" Padding="10,12" Margin="0,0,5,0"/>
                            <Button Content="✕ Cancel" Command="{Binding CommandCtrl.CancelBookingCommand}" Background="#DC2626" Style="{StaticResource OpBtn}" Padding="10,12" Margin="5,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Room Pricing -->
                <Border Style="{StaticResource ICard}" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="🏷️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ROOM PRICING" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Select Room:" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding CommandCtrl.RoomIds}" SelectedItem="{Binding CommandCtrl.SelectedRoomId}" Padding="10,8" Margin="0,0,0,10" Background="#F1F5F9" BorderThickness="0"/>

                        <TextBlock Text="New Price ($/night):" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding CommandCtrl.NewRoomPrice, Converter={StaticResource DecimalInputConverter}, UpdateSourceTrigger=LostFocus}" Padding="10,8" Margin="0,0,0,15" Background="#F1F5F9" BorderThickness="0"/>

                        <Button Content="💰 Apply New Price" Command="{Binding CommandCtrl.AdjustPriceCommand}" Background="#7C3AED" Style="{StaticResource OpBtn}" Padding="10,12"/>
                    </StackPanel>
                </Border>

                <!-- Macro Operations -->
                <Border Style="{StaticResource ICard}" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🔄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="MACRO OPERATIONS" FontSize="11" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Text="Atomically rebook the selected guest into the selected room." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,15"/>
                        
                        <Button Content="🔄 Rebook Guest" Command="{Binding CommandCtrl.RebookCommand}" Background="#D97706" Style="{StaticResource OpBtn}" Padding="10,12"/>
                    </StackPanel>
                </Border>

                <!-- System tools / Demo -->
                <Border Style="{StaticResource ICard}" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SYSTEM TESTS" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Text="Run an automated test to demonstrate transaction rollbacks on failure." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,15"/>
                        
                        <Button Content="⚡ Run Transaction Test" Command="{Binding CommandCtrl.DemoTransactionCommand}" Background="#0F172A" Style="{StaticResource OpBtn}" Padding="10,12" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="{Binding CommandCtrl.TransactionResult}" FontSize="10" Foreground="#0F172A" Background="#F1F5F9" Padding="8" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT PANEL: Action Center (Invoker & History) -->
        <Border Grid.Column="1" Background="White" CornerRadius="16,0,0,16" Padding="30" Margin="10,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.03"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar: Undo/Redo Controls -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding CommandCtrl.UndoCommand}" Background="#1E293B" Style="{StaticResource OpBtn}" Padding="20,12" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↶ Undo" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <Border Background="#475569" CornerRadius="4" Padding="6,0">
                                    <TextBlock Text="{Binding CommandCtrl.UndoCount}" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CommandCtrl.RedoCommand}" Background="#F1F5F9" Style="{StaticResource OpBtn}" Padding="20,12" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↷ Redo" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,8,0"/>
                                <Border Background="#E2E8F0" CornerRadius="4" Padding="6,0">
                                    <TextBlock Text="{Binding CommandCtrl.RedoCount}" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CommandCtrl.UndoAllCommand}" Content="↶↶ Undo All" Background="#EF4444" Style="{StaticResource OpBtn}" Padding="20,12"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="↻ Refresh Data" Command="{Binding CommandCtrl.RefreshCommand}" Background="Transparent" Foreground="#64748B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <!-- Status Banner -->
                <Border Grid.Row="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="15,12" Margin="0,0,0,25">
                    <TextBlock Text="{Binding CommandCtrl.StatusMessage}" FontSize="13" Foreground="#166534" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <!-- History Grid -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#F8FAFC" CornerRadius="8,8,0,0" Padding="20,15" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Audit Trail" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <TextBlock Text=" (Newest first)" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid DockPanel.Dock="Bottom" ItemsSource="{Binding CommandCtrl.HistoryRows}"
                                  IsReadOnly="True" AutoGenerateColumns="False" BorderThickness="0"
                                  Background="White" RowBackground="White" AlternatingRowBackground="#FAFBFC"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  HeadersVisibility="Column" SelectionMode="Single"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="15,12"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimestampFmt}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Setter Property="Margin" Value="15,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="8,4" Margin="10,6" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding StatusIcon}" FontSize="11" Foreground="White" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Category" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CategoryColor}" CornerRadius="4" Padding="8,4" Margin="10,6" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Action Description" Width="*" Binding="{Binding FullDescription}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Foreground" Value="#334155"/>
                                            <Setter Property="Margin" Value="15,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
