<UserControl x:Class="HotelBookingSystem.Views.MediatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HotelBookingSystem.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Department Header Visualization -->
        <Border Grid.Row="0" Background="White" Margin="20" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Hotel Operations — Central Communications Hub" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Reception -->
                    <Border Grid.Column="0" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="8" Padding="15" Margin="5">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔵 Reception" FontWeight="Bold" Foreground="#3B82F6" FontSize="16"/>
                            <TextBlock Text="Guest Management" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Housekeeping -->
                    <Border Grid.Column="1" BorderBrush="#10B981" BorderThickness="2" CornerRadius="8" Padding="15" Margin="5">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🟢 Housekeeping" FontWeight="Bold" Foreground="#10B981" FontSize="16"/>
                            <TextBlock Text="Room Status &amp; Cleaning" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Accounting -->
                    <Border Grid.Column="2" BorderBrush="#F59E0B" BorderThickness="2" CornerRadius="8" Padding="15" Margin="5">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🟠 Accounting" FontWeight="Bold" Foreground="#F59E0B" FontSize="16"/>
                            <TextBlock Text="Payments &amp; Invoices" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <TextBlock Text="All communication between these departments is decoupled through the Mediator Hub." 
                           HorizontalAlignment="Center" Margin="0,15,0,0" Foreground="#94A3B8" FontStyle="Italic" FontSize="12"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Action Panel -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Border Background="White" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Trigger Event" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Select Active Booking:" FontSize="12" Foreground="#64748B" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding AllBookings}" 
                                  SelectedItem="{Binding SelectedBooking}" 
                                  DisplayMemberPath="BookingId"
                                  Padding="10,8" Margin="0,0,0,20"/>

                        <Button Command="{Binding CheckOutCommand}" 
                                Background="#1E293B" Foreground="White" Padding="20,12" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚪" Margin="0,0,8,0"/>
                                <TextBlock Text="Trigger Guest Check-Out" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        
                        <TextBlock Text="Initiating Check-Out from Reception will trigger automated tasks in Housekeeping and Accounting via the Mediator." 
                                   TextWrapping="Wrap" Margin="0,15,0,0" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Communication Log -->
            <Border Grid.Column="1" Background="#0F172A" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Central Hub Event Log" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <Border Background="#1E293B" CornerRadius="4" Padding="8,2" Margin="10,0">
                            <TextBlock Text="LIVE" Foreground="#10B981" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding EventLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Width="100">
                                                <TextBlock Text="{Binding Timestamp}" Foreground="#475569" FontSize="10" FontFamily="Consolas"/>
                                                <TextBlock Text="{Binding Department}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="12"/>
                                            </StackPanel>
                                            
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="#CBD5E1" 
                                                       FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
