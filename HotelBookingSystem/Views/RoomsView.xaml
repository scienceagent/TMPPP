<UserControl x:Class="HotelBookingSystem.Views.RoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HotelBookingSystem.Views"
             xmlns:vm="clr-namespace:HotelBookingSystem.ViewModels"
             xmlns:converters="clr-namespace:HotelBookingSystem.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="#F1F5F9">

    <UserControl.Resources>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        
        <!-- ── Room Card Style ── -->
        <Style x:Key="RoomCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,20,20"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Status Badge ── -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="12"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,25">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Room Inventory" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Manage and monitor room availability and guest assignments." FontSize="14" Foreground="#64748B"/>
            </StackPanel>
            
            <Button DockPanel.Dock="Right" Content="Refresh List" 
                    Command="{Binding RefreshCommand}"
                    Background="#2196F3" Foreground="White" VerticalAlignment="Bottom" Padding="15,8"/>
        </DockPanel>

        <!-- ── Content ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- ── Assigned to Guest Section ── -->
                <StackPanel Margin="0,0,0,40">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Assigned to Guest" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <Border Background="#3B82F6" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AssignedRoomsCount}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding AssignedRooms}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RoomCard}">
                                    <Grid>
                                        <StackPanel>
                                            <!-- Room Image -->
                                            <Border CornerRadius="12,12,0,0" Height="160" ClipToBounds="True">
                                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                            </Border>
                                            
                                            <!-- Details -->
                                            <Border Padding="16">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding RoomNumber, StringFormat='Room {0}'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Price, StringFormat='{}{0:C}/night'}" FontSize="14" FontWeight="SemiBold" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                                                    </DockPanel>
                                                    
                                                    <TextBlock Text="{Binding RoomType}" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>
                                                    
                                                    <Separator Background="#E2E8F0" Margin="0,0,0,12"/>
                                                    
                                                    <!-- Guest Info -->
                                                    <StackPanel>
                                                        <TextBlock Text="GUEST" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding GuestName}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                        
                                                        <TextBlock Text="STAY PERIOD" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,10,0,4"/>
                                                        <TextBlock Text="{Binding Duration}" FontSize="13" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Style="{StaticResource StatusBadge}" Background="#E0F2FE">
                                            <TextBlock Text="{Binding Status}" Foreground="#0369A1" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Empty State -->
                    <TextBlock Text="No rooms currently assigned." FontSize="14" Foreground="#64748B" FontStyle="Italic"
                               Visibility="{Binding AssignedRoomsCount, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}"/>
                </StackPanel>

                <!-- ── Available Rooms Section ── -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Available Rooms" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <Border Background="#10B981" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AvailableRoomsCount}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding AvailableRooms}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RoomCard}">
                                    <Grid>
                                        <StackPanel>
                                            <!-- Room Image -->
                                            <Border CornerRadius="12,12,0,0" Height="160" ClipToBounds="True">
                                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                            </Border>

                                            <!-- Details -->
                                            <Border Padding="16">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding RoomNumber, StringFormat='Room {0}'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Price, StringFormat='{}{0:C}/night'}" FontSize="14" FontWeight="SemiBold" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                                                    </DockPanel>

                                                    <TextBlock Text="{Binding RoomType}" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                                                    <Separator Background="#E2E8F0" Margin="0,0,0,12"/>

                                                    <TextBlock Text="Ready for new guests with full housekeeping service completed." 
                                                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" LineHeight="18"/>
                                                    
                                                    <Button Content="Quick Book" Background="#4CAF50" Foreground="White" Margin="0,16,0,0" Padding="10,6" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Style="{StaticResource StatusBadge}" Background="#DCFCE7">
                                            <TextBlock Text="AVAILABLE" Foreground="#15803D" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
