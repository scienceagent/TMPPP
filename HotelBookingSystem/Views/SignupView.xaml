<UserControl x:Class="HotelBookingSystem.Views.SignupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="800">
    
    <UserControl.Resources>
        <RadialGradientBrush x:Key="LoginSidebarBrush" GradientOrigin="0.5,0.1" Center="0.5,0.1" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#162E44" Offset="0"/>
            <GradientStop Color="#0B1C2C" Offset="1"/>
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceDimBrush}">
        <!-- Main Enterprise Card -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                Width="850" Height="600" Background="White"
                CornerRadius="16" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.08" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE: Branding -->
                <Border Grid.Column="0" CornerRadius="16,0,0,16" Background="{StaticResource LoginSidebarBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                        <Grid Width="70" Height="70" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Polygon Points="35,2 62,18 62,52 35,68 8,52 8,18" Fill="Transparent" Stroke="#C9A84C" StrokeThickness="1.5"/>
                            <Polygon Points="35,8 56,21 56,49 35,62 14,49 14,21" Fill="#C9A84C"/>
                            <TextBlock Text="RG" FontFamily="Georgia, Times New Roman, serif" FontSize="24" FontWeight="Bold" Foreground="#0B1C2C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Join the Team" FontFamily="Georgia, Times New Roman, serif" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Rectangle Height="1" Width="100" Fill="#C9A84C" Margin="0,0,0,20" Opacity="0.8"/>
                        <TextBlock Text="Create your staff account to start managing reservations and hotel operations." 
                                   Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                        
                        <Button Content="← Back to Login" Command="{Binding BackToLoginCommand}"
                                Margin="0,40,0,0" Background="Transparent" Foreground="#C9A84C" 
                                BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- RIGHT SIDE: Form -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="40,30">
                    <StackPanel>
                        <TextBlock Text="Create Account" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Fill in your details to register" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24"/>

                        <!-- Error Message -->
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,20"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FULL NAME" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="13" Padding="10,9" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Margin="0,0,0,14"/>

                                <TextBlock Text="USERNAME" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="13" Padding="10,9" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Margin="0,0,0,14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="EMAIL ADDRESS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="13" Padding="10,9" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Margin="0,0,0,14"/>

                                <TextBlock Text="PASSWORD" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="13" Padding="10,9" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Margin="0,0,0,14"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="PHONE NUMBER" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13" Padding="10,9" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Margin="0,0,0,14"/>

                        <TextBlock Text="ASSIGNED ROLE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Roles}" 
                                  SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                  FontSize="13" Padding="10,8" Background="#FAFBFC" 
                                  BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Margin="0,0,0,24"/>

                        <Button Command="{Binding SignupCommand}"
                                Background="{StaticResource AccentBrush}" Foreground="White" 
                                FontSize="14" FontWeight="SemiBold" Padding="0,14" 
                                BorderThickness="0" Cursor="Hand" Margin="0,0,0,16">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bg" Property="Background" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar Width="40" Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,8,0"/>
                                <TextBlock Text="Create My Account"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Already have an account? " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="Sign In" FontSize="12" Foreground="{StaticResource AccentBrush}" 
                                       Cursor="Hand" FontWeight="SemiBold" TextDecorations="Underline">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding BackToLoginCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
