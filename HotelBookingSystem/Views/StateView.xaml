<UserControl x:Class="HotelBookingSystem.Views.StateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HotelBookingSystem.Views"
             xmlns:vm="clr-namespace:HotelBookingSystem.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status Header -->
        <Border Grid.Row="0" Background="White" Margin="20,20,20,10" CornerRadius="12" Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Select Booking:" FontSize="12" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AllBookings}" 
                              SelectedItem="{Binding SelectedBooking, Mode=TwoWay}" 
                              DisplayMemberPath="BookingId"
                              Width="200" HorizontalAlignment="Left" Margin="0,0,0,15"/>

                    <TextBlock Text="{Binding BookingInfo}" FontSize="14" Foreground="#64748B" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                        <TextBlock Text="Current State: " FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="{Binding CurrentStateName}" FontSize="24" FontWeight="Bold" Foreground="{Binding CurrentStateColor}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentStateDescription}" FontSize="14" Foreground="#475569" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left"/>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="Refresh Data" 
                        Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" 
                        Foreground="#64748B" Padding="15,8" VerticalAlignment="Top">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Actions Panel -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Available Actions" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                
                <UniformGrid Columns="2">
                    <StackPanel Margin="5">
                        <Button Command="{Binding ConfirmCommand}" Content="Confirm Booking" Background="#3B82F6" Style="{StaticResource ActionButton}"/>
                        <TextBlock Text="Transitions to Confirmed state. Requires booking to be in Created state." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="10,0"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <Button Command="{Binding CheckInCommand}" Content="Check In Guest" Background="#10B981" Style="{StaticResource ActionButton}"/>
                        <TextBlock Text="Transitions to Checked-In state. Requires booking to be in Confirmed state." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="10,0"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <Button Command="{Binding CheckOutCommand}" Content="Check Out Guest" Background="#6366F1" Style="{StaticResource ActionButton}"/>
                        <TextBlock Text="Transitions to Checked-Out state. Requires booking to be in Checked-In state." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="10,0"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <Button Command="{Binding CancelCommand}" Content="Cancel Booking" Background="#EF4444" Style="{StaticResource ActionButton}"/>
                        <TextBlock Text="Transitions to Cancelled state. Allowed from Created or Confirmed states." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="10,0"/>
                    </StackPanel>
                </UniformGrid>

                <!-- Error Message Area -->
                <Border Background="#FEF2F2" BorderBrush="#FEE2E2" BorderThickness="1" CornerRadius="8" Margin="5,30,5,0" Padding="15" 
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" Foreground="#EF4444" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="13" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Diagram Visualization -->
                <TextBlock Text="Lifecycle Diagram" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,40,0,15"/>
                <Border Background="White" CornerRadius="12" Padding="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Visual representation of the FSM -->
                        <local:StateNode Title="Created" IsActive="{Binding CurrentStateName, Converter={StaticResource StringEqualConverter}, ConverterParameter=Created}"/>
                        <TextBlock Text="➔" VerticalAlignment="Center" Margin="10,0" Foreground="#CBD5E1" FontSize="20"/>
                        <local:StateNode Title="Confirmed" IsActive="{Binding CurrentStateName, Converter={StaticResource StringEqualConverter}, ConverterParameter=Confirmed}"/>
                        <TextBlock Text="➔" VerticalAlignment="Center" Margin="10,0" Foreground="#CBD5E1" FontSize="20"/>
                        <local:StateNode Title="Checked-In" IsActive="{Binding CurrentStateName, Converter={StaticResource StringEqualConverter}, ConverterParameter=CheckedIn}"/>
                        <TextBlock Text="➔" VerticalAlignment="Center" Margin="10,0" Foreground="#CBD5E1" FontSize="20"/>
                        <local:StateNode Title="Checked-Out" IsActive="{Binding CurrentStateName, Converter={StaticResource StringEqualConverter}, ConverterParameter=CheckedOut}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- History Panel -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Transition History" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                    
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,10">
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#64748B" FontFamily="Consolas"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
