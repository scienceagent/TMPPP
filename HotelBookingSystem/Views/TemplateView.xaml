<UserControl x:Class="HotelBookingSystem.Views.TemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <Style x:Key="TBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ─── Header ─── -->
        <Border Grid.Row="0" Background="White" Margin="20,20,20,10" CornerRadius="12" Padding="24,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#0F172A" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                            <TextBlock Text="TEMPLATE METHOD" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                        </Border>
                        <TextBlock Text="Invoice Generation" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock FontSize="12" Foreground="#64748B" TextWrapping="Wrap"
                               Text="The abstract InvoiceGenerator defines the fixed skeleton (Header → Guest → Charges → Total → Footer). PDF and Email subclasses only override the formatting steps — the algorithm order never changes."/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                        Content="↻  Refresh Bookings"
                        Background="#475569" Style="{StaticResource TBtn}"
                        Padding="16,9" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ─── Body ─── -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Config Panel -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Generator Settings" FontSize="15" FontWeight="Bold"
                               Foreground="#0F172A" Margin="0,0,0,20"/>

                    <!-- Booking selector -->
                    <TextBlock Text="SELECT BOOKING" FontSize="10" FontWeight="Bold"
                               Foreground="#64748B" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AllBookings}"
                              SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                              DisplayMemberPath="BookingId"
                              Padding="10,9" Margin="0,0,0,6"
                              Background="#FAFBFC" BorderBrush="#E2E8F0"/>
                    <TextBlock FontSize="10" Foreground="#94A3B8" Margin="0,0,0,20"
                               Text="No bookings? Create one via New Booking then click Refresh."/>

                    <!-- Format selector -->
                    <TextBlock Text="OUTPUT FORMAT" FontSize="10" FontWeight="Bold"
                               Foreground="#64748B" Margin="0,0,0,6"/>
                    <!-- Format toggle buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <RadioButton x:Name="FmtEmail" Content="Email" IsChecked="True"
                                     GroupName="InvoiceFmt" Padding="14,8" Margin="0,0,6,0"
                                     Foreground="#0F172A" FontSize="12"/>
                        <RadioButton x:Name="FmtPdf"   Content="PDF"
                                     GroupName="InvoiceFmt" Padding="14,8"
                                     Foreground="#0F172A" FontSize="12"/>
                    </StackPanel>

                    <!-- Generate button -->
                    <Button Command="{Binding GenerateCommand}"
                            Content="📄  Generate Invoice"
                            Background="#10B981" Style="{StaticResource TBtn}"
                            Padding="18,12" HorizontalAlignment="Stretch"
                            FontSize="13" Margin="0,0,0,24"/>

                    <!-- Pattern insight card -->
                    <Border Background="#ECFDF5" CornerRadius="8" Padding="14,12"
                            BorderBrush="#6EE7B7" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🧩" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Pattern Insight" FontWeight="Bold"
                                           Foreground="#065F46" FontSize="12"/>
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="#065F46" TextWrapping="Wrap" LineHeight="19"
                                       Text="The abstract base class defines the skeleton: Header → Guest → Charges → Total → Footer. PDF and Email subclasses only override the formatting for each specific step."/>
                        </StackPanel>
                    </Border>

                    <!-- Steps diagram -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14,12" Margin="0,16,0,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="FIXED ALGORITHM ORDER" FontSize="9" FontWeight="Bold"
                                       Foreground="#64748B" Margin="0,0,0,8"/>
                            <TextBlock FontFamily="Cascadia Code, Consolas" FontSize="10"
                                       Foreground="#0F172A" LineHeight="18">
                                <Run>GenerateInvoice()  ← template</Run><LineBreak/>
                                <Run>  1. FormatHeader()</Run><LineBreak/>
                                <Run>  2. FormatGuestInfo()</Run><LineBreak/>
                                <Run>  3. FormatRoomCharges()</Run><LineBreak/>
                                <Run>  4. FormatTotal()</Run><LineBreak/>
                                <Run>  5. FormatFooter()  ← concrete</Run><LineBreak/>
                                <Run>  6. SendToGuest()   ← abstract</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right: Document Preview -->
            <Border Grid.Column="2" Background="#0F172A" CornerRadius="12" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Terminal title bar -->
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="12,12,0,0" Padding="18,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0"/>
                                <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0"/>
                                <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,16,0"/>
                                <TextBlock FontFamily="Cascadia Code, Consolas" FontSize="11"
                                           Foreground="#64748B" VerticalAlignment="Center">
                                    <Run Text="InvoiceGenerator  →  "/>
                                    <Run Text="{Binding SelectedFormat}" Foreground="#10B981"/>
                                    <Run Text="InvoiceGenerator" Foreground="#10B981"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="10" Foreground="#334155">
                                <Run Text="booking: "/>
                                <Run Text="{Binding SelectedBooking.BookingId}" Foreground="#7DD3FC"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Output -->
                    <Border Grid.Row="1" CornerRadius="0,0,12,12" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding GeneratedInvoice}"
                                       Foreground="#A5F3C7"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       LineHeight="22"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
