<UserControl x:Class="HotelBookingSystem.Views.VisitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ─── Header banner ─── -->
        <Border Grid.Row="0" Background="#1E293B" Margin="20" CornerRadius="12" Padding="24,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.15" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="#312E81" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                            <TextBlock Text="VISITOR" FontSize="9" FontWeight="Bold" Foreground="#A5B4FC"/>
                        </Border>
                        <TextBlock Text="System-Wide Analytics" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                    <TextBlock FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"
                               Text="Traverses Booking and User repositories using Double Dispatch — element.Accept(visitor) calls back visitor.Visit(this). New analytics can be added as new Visitor classes without modifying any model."/>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding RunAnalyticsCommand}"
                        Background="#6366F1" Foreground="White"
                        Padding="22,12" FontWeight="Bold" FontSize="13"
                        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#4F46E5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Margin="0,0,8,0" FontSize="14"/>
                        <TextBlock Text="Run Analytics" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ─── Body ─── -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: How It Works -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="How Double Dispatch Works" FontSize="15" FontWeight="Bold"
                               Foreground="#0F172A" Margin="0,0,0,20"/>

                    <!-- Step 1 -->
                    <Border Background="#EEF2FF" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#6366F1" CornerRadius="10" Width="22" Height="22" Margin="0,0,8,0">
                                    <TextBlock Text="1" FontSize="10" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Accept the Visitor" FontWeight="SemiBold" Foreground="#3730A3"/>
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="#4338CA" TextWrapping="Wrap" Margin="30,0,0,0"
                                       Text="Models (Booking, User) implement IVisitable. Calling booking.Accept(visitor) delegates control to the visitor."/>
                        </StackPanel>
                    </Border>

                    <!-- Step 2 -->
                    <Border Background="#EEF2FF" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#6366F1" CornerRadius="10" Width="22" Height="22" Margin="0,0,8,0">
                                    <TextBlock Text="2" FontSize="10" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Double Dispatch" FontWeight="SemiBold" Foreground="#3730A3"/>
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="#4338CA" TextWrapping="Wrap" Margin="30,0,0,0"
                                       Text="The element calls visitor.Visit(this) — passing its concrete type. The compiler selects the correct overload without any 'if' or 'is' checks."/>
                        </StackPanel>
                    </Border>

                    <!-- Step 3 -->
                    <Border Background="#EEF2FF" CornerRadius="8" Padding="14,12" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#6366F1" CornerRadius="10" Width="22" Height="22" Margin="0,0,8,0">
                                    <TextBlock Text="3" FontSize="10" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Open for Extension" FontWeight="SemiBold" Foreground="#3730A3"/>
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="#4338CA" TextWrapping="Wrap" Margin="30,0,0,0"
                                       Text="New analytics (ExportVisitor, MaintenanceVisitor…) are added as new classes — Booking and User models never change."/>
                        </StackPanel>
                    </Border>

                    <Separator Background="#F1F5F9" Margin="0,0,0,16"/>

                    <!-- Current visitor capabilities -->
                    <TextBlock Text="STATISTICS VISITOR — OPERATIONS" FontSize="9" FontWeight="Bold"
                               Foreground="#64748B" Margin="0,0,0,10"/>
                    <StackPanel>
                        <Border Background="#F5F3FF" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰" Margin="0,0,8,0"/>
                                <TextBlock Text="Total revenue from all bookings" FontSize="12" Foreground="#4C1D95"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F5F3FF" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏨" Margin="0,0,8,0"/>
                                <TextBlock Text="Revenue by room type" FontSize="12" Foreground="#4C1D95"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F5F3FF" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌙" Margin="0,0,8,0"/>
                                <TextBlock Text="Total room-nights sold" FontSize="12" Foreground="#4C1D95"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F5F3FF" CornerRadius="6" Padding="10,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" Margin="0,0,8,0"/>
                                <TextBlock Text="Guest count aggregation" FontSize="12" Foreground="#4C1D95"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right: Analytics Engine Terminal -->
            <Border Grid.Column="2" Background="#0F172A" CornerRadius="12" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Terminal bar -->
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="12,12,0,0" Padding="18,12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0"/>
                            <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0"/>
                            <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,16,0"/>
                            <TextBlock Text="StatisticsVisitor  →  Double Dispatch Engine"
                                       FontFamily="Cascadia Code, Consolas" FontSize="11"
                                       Foreground="#64748B" VerticalAlignment="Center"/>
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="8,2" Margin="16,0">
                                <TextBlock Text="LIVE" Foreground="#93C5FD" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Output -->
                    <Border Grid.Row="1" CornerRadius="0,0,12,12" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding AnalyticsOutput}"
                                       Foreground="#E2E8F0"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="14"
                                       LineHeight="24"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
